generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Tenancy
//
// Every row below belongs to exactly one Couple. `createdBy` stays the
// existing role vocabulary ("Wife" | "Husband") — it is (coupleId, role)
// together that identifies a person, which is why the role literals
// throughout the app keep working unchanged.
//
// coupleId is required on every tenant model. The one exception is
// Invite.coupleId, where null means "this invite starts a new couple".
// ─────────────────────────────────────────────────────────────

model Couple {
  id          String   @id @default(uuid())
  displayName String                          // "Budoor & Emad"
  startDate   DateTime                        // was NEXT_PUBLIC_RELATIONSHIP_START
  // Superseded by CoupleUser rows of kind "child". Kept unread for one
  // deploy so the backfill can be checked before the column goes.
  childName   String?
  timezone    String   @default("Asia/Muscat")
  // Oman declares the Hijri month by local sighting, so the computed
  // (Umm al-Qura) date can be a day out. -1, 0 or +1 to match what was
  // actually announced.
  hijriOffset Int      @default(0)
  // Who may hand out invitations to whole new families. This was inferred
  // from "the oldest couple", which quietly moves if a family is ever
  // deleted and recreated — a bad thing to hang a permission on.
  canInviteFamilies Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                CoupleUser[]
  invites              Invite[]
  calendarEvents       CalendarEvent[]
  googleCalendarTokens GoogleCalendarToken[]
  notes                Note[]
  bucketItems          BucketItem[]
  streaks              Streak[]
  achievements         Achievement[]
  memories             Memory[]
  recurringSeries      RecurringSeries[]
  specialDates         SpecialDate[]
  reminders            Reminder[]
  dailyHighlights      DailyHighlight[]
  pushSubscriptions    PushSubscription[]
  comments             Comment[]
  reactions            Reaction[]
  feedTokens           FeedToken[]
}

/**
 * Everyone in the family — the two partners and any children.
 *
 * `role` is null for children, and that single fact does a lot of work:
 * Postgres treats each NULL as distinct, so @@unique([coupleId, role]) still
 * permits exactly one Wife and one Husband while allowing any number of kids.
 * `email` is nullable for the same reason — children have none, and several
 * NULLs coexist happily under a unique index.
 */
model CoupleUser {
  id        String   @id @default(uuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  role      String?  // "Wife" | "Husband" for partners, null for children
  kind      String   @default("adult") // "adult" | "child"
  email     String?  @unique           // children have none
  name      String
  title     String?  // what they're called instead of the role: "Partner"
  birthday  String?  // "MM-DD"
  createdAt DateTime @default(now())

  @@unique([coupleId, role])
  @@index([coupleId, kind])
}

model Invite {
  id        String    @id @default(uuid())
  token     String    @unique
  coupleId  String?   // null = this invite starts a brand-new couple
  couple    Couple?   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  role      String?   // which side of an existing couple is being filled
  email     String?   // optional pre-binding to one address
  note      String?   // who you sent it to, for your own records
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

/**
 * A secret URL that serves one person's calendar as a subscribable .ics feed.
 *
 * Calendar clients cannot send an Authorization header, so the token lives in
 * the URL — the same "secret address" pattern Google and Apple use for their
 * own private feeds. It is therefore a password in link form: read-only, one
 * person's view of one family, and revocable on its own.
 *
 * Stored in the clear deliberately. It has to be re-readable to be added to a
 * second device, and it is only ever returned to that person's own session.
 */
model FeedToken {
  id         String    @id @default(uuid())
  coupleId   String
  couple     Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  userId     String    // role within the family
  token      String    @unique
  // What the home-screen widget shows, chosen by its owner. Null until they
  // change something, so the defaults live in one place in code.
  widgetConfig Json?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([coupleId, userId])
}

// ─────────────────────────────────────────────────────────────
// Tenant data
// ─────────────────────────────────────────────────────────────

model CalendarEvent {
  id                  String   @id @default(uuid())
  coupleId            String   @default("")
  couple              Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  title               String
  notes               String?
  date                DateTime
  endDate             DateTime?
  time                String
  endTime             String?
  category            String?
  personTag           String?  // "family" | "couple" | "wife" | "husband" | "child"
  allDay              Boolean  @default(false)
  createdBy           String
  status              String   @default("pending")
  archived            Boolean  @default(false)
  googleEventId       String?
  creatorGoogleEventId String?
  seriesId            String?
  series              RecurringSeries? @relation(fields: [seriesId], references: [id])
  isRecurring         Boolean  @default(false)
  isRecurringInstance Boolean  @default(false)
  specialDateId       String?
  specialDate         SpecialDate?    @relation(fields: [specialDateId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memories            Memory[]

  @@index([coupleId, date])
  @@index([coupleId, status, archived, date])
}

model GoogleCalendarToken {
  id           String   @id @default(uuid())
  coupleId     String   @default("")
  couple       Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  userId       String   // role within the couple
  accessToken  String
  refreshToken String?
  expiryDate   DateTime?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Was globally unique on userId — that allowed only one "Husband" token
  // in the entire database.
  @@unique([coupleId, userId])
}

model Note {
  id        String    @id @default(uuid())
  coupleId  String   @default("")
  couple    Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  content   String
  kind      String    @default("note") // "note" | "gratitude"
  createdBy String    // "Wife" | "Husband"
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([coupleId, createdAt])
}

model BucketItem {
  id        String   @id @default(uuid())
  coupleId  String   @default("")
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  title     String
  category  String   @default("other")
  notes     String?
  completed Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())

  @@index([coupleId])
}

model Streak {
  id            String   @id @default(uuid())
  coupleId      String   @default("")
  couple        Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  userId        String   // role within the couple
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastWeekStart DateTime
  updatedAt     DateTime @updatedAt

  // Was globally unique on userId — couples would have shared one streak row.
  @@unique([coupleId, userId])
}

model Achievement {
  id         String   @id @default(uuid())
  coupleId   String   @default("")
  couple     Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  userId     String   // role within the couple
  badgeId    String
  unlockedAt DateTime @default(now())

  // Was globally unique — only one couple could ever earn each badge.
  @@unique([coupleId, userId, badgeId])
}

model Memory {
  id        String        @id @default(uuid())
  coupleId  String   @default("")
  couple    Couple        @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rating    Int
  journal   String?
  photos    String?       // JSON array of blob URLs
  createdBy String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([eventId, createdBy])
  @@index([coupleId])
}

model RecurringSeries {
  id             String          @id @default(uuid())
  coupleId       String   @default("")
  couple         Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  title          String
  notes          String?
  category       String?
  allDay         Boolean         @default(false)
  time           String
  endTime        String?
  createdBy      String
  frequency      String
  interval       Int             @default(1)
  startDate      DateTime
  endDate        DateTime?
  generatedUntil DateTime
  status         String          @default("active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  events         CalendarEvent[]

  @@index([coupleId])
}

model SpecialDate {
  id        String   @id @default(uuid())
  coupleId  String   @default("")
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  type      String   @default("annual")
  kind      String   @default("other") // "birthday" | "anniversary" | "milestone" | "other"
  emoji     String?
  createdBy String
  createdAt DateTime @default(now())

  events    CalendarEvent[]

  @@index([coupleId])
}

model Reminder {
  id                    String   @id @default(uuid())
  coupleId              String   @default("")
  couple                Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  title                 String
  date                  DateTime
  time                  String
  endTime               String?
  createdBy             String
  sent24h               Boolean  @default(false)
  sent1h                Boolean  @default(false)
  googleEventIdWife     String?
  googleEventIdHusband  String?
  createdAt             DateTime @default(now())

  @@index([coupleId, date])
}

model DailyHighlight {
  id        String   @id @default(uuid())
  coupleId  String   @default("")
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD" in the couple's timezone
  note      String?
  photos    String?  // JSON array of blob URLs
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Was unique on [date, createdBy] alone. /api/highlights upserts on this
  // key, so without coupleId one couple's highlight would silently overwrite
  // another couple's highlight for the same day and role.
  @@unique([coupleId, date, createdBy])
}

model PushSubscription {
  id        String   @id @default(uuid())
  coupleId  String   @default("")
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  userId    String   // role within the couple
  endpoint  String   @unique // genuinely global: one browser, one subscription
  keys      String   // JSON: { p256dh, auth }
  createdAt DateTime @default(now())

  @@index([coupleId, userId])
}

model Comment {
  id         String   @id @default(uuid())
  coupleId   String   @default("")
  couple     Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  targetType String   // "memory" | "highlight"
  targetId   String
  content    String
  createdBy  String   // "Wife" | "Husband"
  createdAt  DateTime @default(now())

  @@index([coupleId, targetType, targetId])
}

model Reaction {
  id         String   @id @default(uuid())
  coupleId   String   @default("")
  couple     Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  targetType String   // "memory" | "highlight"
  targetId   String
  emoji      String
  createdBy  String   // "Wife" | "Husband"
  createdAt  DateTime @default(now())

  @@unique([coupleId, targetType, targetId, createdBy, emoji])
  @@index([coupleId, targetType, targetId])
}
